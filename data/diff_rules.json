    "seat_other_field": "review",
    "layer_added_removed_or_dates": "review",
    "district_id_or_name": "review",
    "district_geometry": "review",
    "parcel_rows_moved": "stop",
    "address_district_without_boundary_move": "review",
    "address_district_with_boundary_move": "pass",
    "split_addresses": "review",
    "addresses_added_or_removed": "pass",
    "address_point_moved": "pass",
    "neighbourhood_added_or_removed": "review",
    "neighbourhood_name": "review",
    "neighbourhood_districts": "review",
    "neighbourhood_other_field": "review"
  }
}
